<main class="catalog-page">
    <section class="catalog-intro" aria-labelledby="catalog-title">
        <p class="eyebrow">Catflix Originals</p>
        <h2 id="catalog-title">Películas y Actores</h2>
        <p>Explora el reparto de cada película o descubre todas las películas de un actor.</p>

        <!-- Barra de búsqueda -->
        <div class="search-bar">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" id="searchInput" class="search-input" placeholder="Buscar por título o nombre..." aria-label="Buscar películas o actores">
                <button type="button" class="search-clear" id="searchClear" aria-label="Limpiar búsqueda">✕</button>
            </div>
        </div>
    </section>

    <div class="container catalog-container">
        <div class="items-grid" id="itemsGrid">
            <div class="empty-msg">
                Cargando catálogo...
            </div>
        </div>
    </div>

    <!-- Sección de formularios -->
    <section class="container form-section" aria-labelledby="add-content-title">
        <div class="form-launcher">
            <p class="eyebrow">Tu catálogo</p>
            <h2 id="add-content-title">Agregar nuevo contenido</h2>
            <p>Elige qué quieres agregar al catálogo.</p>
            <div class="form-launcher-actions">
                <button type="button" class="btn-content-choice" id="btnNuevaPelicula" onclick="mostrarFormulario('pelicula')" aria-controls="panelPelicula" aria-expanded="false">🎬 Nueva película</button>
                <button type="button" class="btn-content-choice" id="btnNuevoActor" onclick="mostrarFormulario('actor')" aria-controls="panelActor" aria-expanded="false">🎭 Nuevo actor</button>
                <button type="button" class="btn-content-choice" id="btnAsignar" onclick="mostrarFormulario('asignar')" aria-controls="panelAsignar" aria-expanded="false">🔗 Asignar actor</button>
            </div>
        </div>

        <div class="forms-grid" id="formsGrid">
            <!-- Formulario: Nueva Película -->
            <div class="form-box" id="panelPelicula" hidden>
                <h3>Nueva Película</h3>
                <form id="formPelicula" onsubmit="agregarPelicula(event)">
                    <input type="text" id="movieTitulo" placeholder="Título" required>
                    <input type="number" id="movieAnio" placeholder="Año" required min="1888" max="2100">
                    <p class="form-hint">La imagen y el reparto principal se buscarán automáticamente en TMDB.</p>
                    <button type="submit" class="btn-add-movie">Agregar Película</button>
                </form>
                <div id="msgPelicula" class="message"></div>
            </div>

            <!-- Formulario: Nuevo Actor -->
            <div class="form-box" id="panelActor" hidden>
                <h3>Nuevo Actor</h3>
                <form id="formActor" onsubmit="agregarActor(event)">
                    <input type="text" id="actorNombre" placeholder="Nombre completo" required>
                    <input type="date" id="actorFecha" placeholder="Fecha de nacimiento (opcional)">
                    <input type="text" id="actorImagen" placeholder="URL de la foto (opcional)">
                    <p class="form-hint">La imagen y la fecha de nacimiento se buscarán automáticamente en TMDB.</p>
                    <button type="submit" class="btn-add-actor">Agregar Actor</button>
                </form>
                <div id="msgActor" class="message"></div>
            </div>

            <!-- Formulario: Asignar Actor a Película -->
            <div class="form-box" id="panelAsignar" hidden>
                <h3>Asignar Actor a Película</h3>
                <form id="formAsignar" onsubmit="asignarActor(event)">
                    <select id="asignarPelicula" required>
                        <option value="">Selecciona una película...</option>
                    </select>
                    <select id="asignarActor" required>
                        <option value="">Selecciona un actor...</option>
                    </select>
                    <button type="submit" class="btn-add-series">Asignar Actor</button>
                </form>
                <div id="msgAsignar" class="message"></div>
            </div>
        </div>
    </section>
</main>

<!-- Modal de detalle -->
<section class="detail-modal" id="detailModal" role="dialog" aria-modal="true" aria-labelledby="detailTitle" hidden>
    <div class="detail-modal-backdrop"></div>
    <div class="detail-modal-panel" id="detailModalPanel">
        <button type="button" class="btn-back-catalog" onclick="cerrarDetalle()">← Volver al catálogo</button>
        <div class="detail-modal-content" id="detailModalContent"></div>
    </div>
</section>